(* #"crates/ptrng-spsc/src/spsc.rs" 89 4 89 24 *)

(* spsc::RingBuffer<T, N> *)

let%span sinvariant = "../../creusot/creusot-std/src/invariant.rs" 85 8 85 18
let%span sspsc = "crates/ptrng-spsc/src/spsc.rs" 90 23 90 35
let%span sspsc'0 = "crates/ptrng-spsc/src/spsc.rs" 90 8 90 36
let%span sspsc'1 = "crates/ptrng-spsc/src/spsc.rs" 87 15 87 21
let%span sspsc'2 = "crates/ptrng-spsc/src/spsc.rs" 89 20 89 24
let%span sspsc'3 = "crates/ptrng-spsc/src/spsc.rs" 88 14 88 37
let%span sspsc'4 = "crates/ptrng-spsc/src/spsc.rs" 103 20 103 24
let%span sspsc'5 = "crates/ptrng-spsc/src/spsc.rs" 101 15 101 21
let%span sspsc'6 = "crates/ptrng-spsc/src/spsc.rs" 103 32 103 36
let%span sspsc'7 = "crates/ptrng-spsc/src/spsc.rs" 102 14 102 37
let%span sspsc'8 = "crates/ptrng-spsc/src/spsc.rs" 73 12 73 86
let%span sspsc'9 = "crates/ptrng-spsc/src/spsc.rs" 35 12 39 13
let%span sspsc'10 = "crates/ptrng-spsc/src/spsc.rs" 59 20 59 64
let%span sord = "../../creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sarray = "../../creusot/creusot-std/src/std/array.rs" 9 20 9 51
let%span sseq = "../../creusot/creusot-std/src/logic/seq.rs" 994 20 994 91

use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_T

predicate precondition_default (self: ()) (args: ())

axiom precondition_fndef: forall args: () [precondition_default () args]. (let () = args in true)
    -> precondition_default () args

predicate inv_T (_1: t_T)

predicate postcondition_default (self: ()) (args: ()) (result: t_T)

axiom postcondition_fndef:
  forall args: (), res: t_T [postcondition_default () args res]. postcondition_default () args res
    -> (let () = args in inv_T res)

predicate postcondition_once_default (self: ()) (args: ()) (result: t_T) = postcondition_default self args result

meta "rewrite_def" predicate postcondition_once_default

let default_T (return (x: t_T)) = {[@stop_split] [@expl:default requires] precondition_default () ()}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:default ensures] postcondition_once_default () () result}
    (! return {result}) ]

type t_RingBuffer_T = { buf: Slice64.array t_T; fill: t_T; head: UInt64.t; len: UInt64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_N [#"crates/ptrng-spsc/src/spsc.rs" 78 24 78 38] : UInt64.t

predicate invariant_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 58 4 58 30] (self: t_RingBuffer_T) =
  [%#sspsc'10] gt_log_Int (UInt64.t'int const_N) 0
  /\ UInt64.t'int self.head < UInt64.t'int const_N /\ UInt64.t'int self.len <= UInt64.t'int const_N

predicate invariant_ref_T [@inline:trivial] (self: t_T) = [%#sinvariant] inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate invariant_array_T_n (self: Slice64.array t_T) =
  [%#sarray] inv_Seq_T (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int const_N

predicate inv_array_T_n [@inline:trivial] (_1: Slice64.array t_T) = invariant_array_T_n _1

meta "rewrite_def" predicate inv_array_T_n

predicate inv_RingBuffer_T (_1: t_RingBuffer_T)

axiom inv_axiom [@rewrite]: forall x: t_RingBuffer_T [inv_RingBuffer_T x]. inv_RingBuffer_T x
    = (invariant_RingBuffer_T x /\ inv_array_T_n x.buf /\ inv_T x.fill)

function slot_index_T [#"crates/ptrng-spsc/src/spsc.rs" 33 4 33 58] (head'0: int) (offset: int) (cap: int) : int =
  [%#sspsc'9] if offset < cap - head'0 then head'0 + offset else offset - (cap - head'0)

function view_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 71 4 71 33] (self: t_RingBuffer_T) : Seq.seq t_T =
  [%#sspsc'8] Seq.create (UInt64.t'int self.len) (fun (i: int) -> Seq.get (Slice64.view self.buf) (slot_index_T (UInt64.t'int self.head) i (UInt64.t'int const_N)))

let new_with_T (fill'0: t_T) (return (x: t_RingBuffer_T)) =
{[@stop_split] [@expl:new_with_T requires] ([@stop_split] [@expl:new_with 'fill' type invariant] [%#sspsc'4] inv_T fill'0)
  /\ ([@stop_split] [@expl:new_with requires] [%#sspsc'5] gt_log_Int (UInt64.t'int const_N) 0)}
  any
  [ return (result: t_RingBuffer_T) ->
  {[@stop_split] [@expl:new_with_T ensures] ([@stop_split] [@expl:new_with result type invariant] [%#sspsc'6] inv_RingBuffer_T result)
    /\ ([@stop_split] [@expl:new_with ensures] [%#sspsc'7] view_RingBuffer_T result = (Seq.empty: Seq.seq t_T))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let new_T [#"crates/ptrng-spsc/src/spsc.rs" 89 4 89 24] (return (x: t_RingBuffer_T)) =
{[@stop_split] [@expl:new requires] [%#sspsc'1] gt_log_Int (UInt64.t'int const_N) 0}
  (! bb0
  [ bb0 = s0
    [ s0 = default_T [%#sspsc] (fun (_x: t_T) -> [ &_3 <- _x ] s1)
    | s1 = new_with_T [%#sspsc'0] {_3} (fun (_x: t_RingBuffer_T) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ] [ & _ret: t_RingBuffer_T = Any.any_l () | & _3: t_T = Any.any_l () ])
  [ return (result: t_RingBuffer_T) ->
  {[@stop_split] [@expl:new_T ensures] ([@stop_split] [@expl:new result type invariant] [%#sspsc'2] inv_RingBuffer_T result)
    /\ ([@stop_split] [@expl:new ensures] [%#sspsc'3] view_RingBuffer_T result = (Seq.empty: Seq.seq t_T))}
    (! return {result}) ]
