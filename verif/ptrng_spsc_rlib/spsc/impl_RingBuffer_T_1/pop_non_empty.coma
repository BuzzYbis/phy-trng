  /\ ([@stop_split] [@expl:pop_non_empty requires] [%#sspsc'13] gt_log_Int (Seq.length (view_RingBuffer_T self.current)) 0)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_old_self <- [%#sspsc] self.current ] s1
    | s1 = [ &_12 <- self.current.head ] s2
    | s2 = [ &_13 <- UInt64.lt _12 ([%#sspsc'0] const_N) ] s3
