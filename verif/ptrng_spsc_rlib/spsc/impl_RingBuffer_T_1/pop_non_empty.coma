    | s9 = UInt64.add [%#sspsc'4] {self.current.head} {[%#sspsc'3] (1: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_19 <- _x ] s10)
    | s10 = [ &_18 <- UInt64.lt _19 ([%#sspsc'5] const_N) ] s11
    | s11 = any [ br0 -> {_18 = false} (! bb5) | br1 -> {_18} (! bb4) ] ]
  | bb4 = s0
    [ s0 = UInt64.add [%#sspsc'7] {self.current.head} {[%#sspsc'6] (1: UInt64.t)}
