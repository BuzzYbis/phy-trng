    | s1 = bb6 ]
  | bb5 = s0 [ s0 = [ &_17 <- [%#sspsc'8] (0: UInt64.t) ] s1 | s1 = bb6 ]
  | bb6 = s0
    [ s0 = [ &self <- { self with current = { self.current with head = _17 } } ] s1
    | s1 = UInt64.sub [%#sspsc'10] {self.current.len} {[%#sspsc'9] (1: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &self <- { self with current = { self.current with len = _x } } ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_RingBuffer_T self} any) ]
    | s3 = -{resolve_refmut_RingBuffer_T self}- s4
    | s4 =
      {[@expl:assertion] [%#sspsc'11] Seq.(==) (view_RingBuffer_T self.current) (Seq.([..]) (view_RingBuffer_T _old_self) 1 (Seq.length (view_RingBuffer_T _old_self)))}
      s5
    | s5 = [ &_ret <- value ] s6
    | s6 = return {_ret} ] ]
  [ & _ret: t_T = Any.any_l ()
  | & self: MutBorrow.t t_RingBuffer_T = self
  | & _old_self: t_RingBuffer_T = Any.any_l ()
  | & value: t_T = Any.any_l ()
  | & _12: UInt64.t = Any.any_l ()
  | & _13: bool = Any.any_l ()
  | & _15: UInt64.t = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _17: UInt64.t = Any.any_l ()
  | & _18: bool = Any.any_l ()
