(* spsc::RingBuffer<T, N> *)

let%span sinvariant = "../../creusot/creusot-std/src/invariant.rs" 93 20 93 44
let%span sinvariant'0 = "../../creusot/creusot-std/src/invariant.rs" 85 8 85 18
let%span sspsc = "crates/ptrng-spsc/src/spsc.rs" 173 11 173 25
let%span sspsc'0 = "crates/ptrng-spsc/src/spsc.rs" 176 8 176 39
let%span sspsc'1 = "crates/ptrng-spsc/src/spsc.rs" 172 25 172 29
let%span sspsc'2 = "crates/ptrng-spsc/src/spsc.rs" 172 31 172 36
let%span sspsc'3 = "crates/ptrng-spsc/src/spsc.rs" 168 14 171 5
let%span sspsc'4 = "crates/ptrng-spsc/src/spsc.rs" 145 20 145 24
let%span sspsc'5 = "crates/ptrng-spsc/src/spsc.rs" 144 14 144 43
let%span sspsc'6 = "crates/ptrng-spsc/src/spsc.rs" 286 32 286 36
let%span sspsc'7 = "crates/ptrng-spsc/src/spsc.rs" 286 38 286 43
let%span sspsc'8 = "crates/ptrng-spsc/src/spsc.rs" 284 15 284 34
let%span sspsc'9 = "crates/ptrng-spsc/src/spsc.rs" 285 14 285 51
let%span sspsc'10 = "crates/ptrng-spsc/src/spsc.rs" 73 12 73 86
let%span sspsc'11 = "crates/ptrng-spsc/src/spsc.rs" 35 12 39 13
let%span sspsc'12 = "crates/ptrng-spsc/src/spsc.rs" 59 20 59 64
let%span sord = "../../creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sarray = "../../creusot/creusot-std/src/std/array.rs" 9 20 9 51
let%span sseq = "../../creusot/creusot-std/src/logic/seq.rs" 994 20 994 91

use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_T

type t_RingBuffer_T = { buf: Slice64.array t_T; fill: t_T; head: UInt64.t; len: UInt64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_N [#"crates/ptrng-spsc/src/spsc.rs" 94 14 94 28] : UInt64.t

predicate invariant_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 58 4 58 30] (self: t_RingBuffer_T) =
  [%#sspsc'12] gt_log_Int (UInt64.t'int const_N) 0
  /\ UInt64.t'int self.head < UInt64.t'int const_N /\ UInt64.t'int self.len <= UInt64.t'int const_N

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = [%#sinvariant'0] inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate invariant_array_T_n (self: Slice64.array t_T) =
  [%#sarray] inv_Seq_T (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int const_N

predicate inv_array_T_n [@inline:trivial] (_1: Slice64.array t_T) = invariant_array_T_n _1

meta "rewrite_def" predicate inv_array_T_n

predicate inv_RingBuffer_T (_1: t_RingBuffer_T)

axiom inv_axiom [@rewrite]: forall x: t_RingBuffer_T [inv_RingBuffer_T x]. inv_RingBuffer_T x
    = (invariant_RingBuffer_T x /\ inv_array_T_n x.buf /\ inv_T x.fill)

predicate invariant_ref_RingBuffer_T [@inline:trivial] (self: t_RingBuffer_T) = [%#sinvariant'0] inv_RingBuffer_T self

meta "rewrite_def" predicate invariant_ref_RingBuffer_T

predicate inv_ref_RingBuffer_T [@inline:trivial] (_1: t_RingBuffer_T) = invariant_ref_RingBuffer_T _1

meta "rewrite_def" predicate inv_ref_RingBuffer_T

function slot_index_T [#"crates/ptrng-spsc/src/spsc.rs" 33 4 33 58] (head'0: int) (offset: int) (cap: int) : int =
  [%#sspsc'11] if offset < cap - head'0 then head'0 + offset else offset - (cap - head'0)

function view_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 71 4 71 33] (self: t_RingBuffer_T) : Seq.seq t_T =
  [%#sspsc'10] Seq.create (UInt64.t'int self.len) (fun (i: int) -> Seq.get (Slice64.view self.buf) (slot_index_T (UInt64.t'int self.head) i (UInt64.t'int const_N)))

let is_full_T (self: t_RingBuffer_T) (return (x: bool)) =
{[@stop_split] [@expl:is_full 'self' type invariant] [%#sspsc'4] inv_ref_RingBuffer_T self}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:is_full ensures] [%#sspsc'5] result
    = (Seq.length (view_RingBuffer_T self) = UInt64.t'int const_N)}
    (! return {result}) ]

predicate invariant_refmut_RingBuffer_T [@inline:trivial] (self: MutBorrow.t t_RingBuffer_T) =
  [%#sinvariant] inv_RingBuffer_T self.current /\ inv_RingBuffer_T self.final

meta "rewrite_def" predicate invariant_refmut_RingBuffer_T

predicate inv_refmut_RingBuffer_T [@inline:trivial] (_1: MutBorrow.t t_RingBuffer_T) = invariant_refmut_RingBuffer_T _1

meta "rewrite_def" predicate inv_refmut_RingBuffer_T

predicate resolve_refmut_RingBuffer_T [@inline:trivial] (_1: MutBorrow.t t_RingBuffer_T) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_RingBuffer_T

type t_SpscError = Full

type t_Result_unit_SpscError = Ok () | Err t_SpscError

let push_into_available_T (self: MutBorrow.t t_RingBuffer_T) (value: t_T) (return (x: ())) =
{[@stop_split] [@expl:push_into_available_T requires] ([@stop_split] [@expl:push_into_available 'self' type invariant] [%#sspsc'6] inv_refmut_RingBuffer_T self)
  /\ ([@stop_split] [@expl:push_into_available 'value' type invariant] [%#sspsc'7] inv_T value)
  /\ ([@stop_split] [@expl:push_into_available requires] [%#sspsc'8] Seq.length (view_RingBuffer_T self.current)
  < UInt64.t'int const_N)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:push_into_available ensures] [%#sspsc'9] view_RingBuffer_T self.final
    = Seq.snoc (view_RingBuffer_T self.current) value}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let try_push_T [#"crates/ptrng-spsc/src/spsc.rs" 172 4 172 65] (self: MutBorrow.t t_RingBuffer_T) (value: t_T)
  (return (x: t_Result_unit_SpscError)) =
{[@stop_split] [@expl:try_push_T requires] ([@stop_split] [@expl:try_push 'self' type invariant] [%#sspsc'1] inv_refmut_RingBuffer_T self)
  /\ ([@stop_split] [@expl:try_push 'value' type invariant] [%#sspsc'2] inv_T value)}
  (! bb0
  [ bb0 = s0
    [ s0 = is_full_T [%#sspsc] {self.current} (fun (_x: bool) -> [ &_7 <- _x ] s1)
    | s1 = any [ br0 -> {_7 = false} (! bb3) | br1 -> {_7} (! bb2) ] ]
  | bb2 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_RingBuffer_T self} any) ]
    | s1 = -{resolve_refmut_RingBuffer_T self}- s2
    | s2 = [ &_10 <- Full ] s3
    | s3 = [ &_ret <- Err _10 ] s4
    | s4 = return {_ret} ]
  | bb3 = s0
    [ s0 = MutBorrow.borrow_final <t_RingBuffer_T> {self.current} {MutBorrow.get_id self}
        (fun (_bor: MutBorrow.t t_RingBuffer_T) ->
          [ &_12 <- _bor ] -{inv_RingBuffer_T _bor.final}-
          [ &self <- { self with current = _bor.final } ] s1)
      [ _ck -> (! {[@expl:type invariant] inv_RingBuffer_T self.current} any) ]
    | s1 = push_into_available_T [%#sspsc'0] {_12} {value} (fun (_x: ()) -> [ &_11 <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_RingBuffer_T self} any) ]
    | s3 = -{resolve_refmut_RingBuffer_T self}- s4
    | s4 = [ &_ret <- Ok _14 ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Result_unit_SpscError = Any.any_l ()
  | & self: MutBorrow.t t_RingBuffer_T = self
  | & value: t_T = value
  | & _7: bool = Any.any_l ()
  | & _10: t_SpscError = Any.any_l ()
  | & _11: () = Any.any_l ()
  | & _12: MutBorrow.t t_RingBuffer_T = Any.any_l ()
  | & _14: () = Any.any_l () ])
  [ return (result: t_Result_unit_SpscError) -> {[@stop_split] [@expl:try_push ensures] [%#sspsc'3] match result with
      | Ok () -> Seq.length (view_RingBuffer_T self.current) < UInt64.t'int const_N
      /\ view_RingBuffer_T self.final = Seq.snoc (view_RingBuffer_T self.current) value
      | Err (Full) -> Seq.length (view_RingBuffer_T self.current) = UInt64.t'int const_N
      /\ view_RingBuffer_T self.final = view_RingBuffer_T self.current
      end}
    (! return {result}) ]
