(* #"crates/ptrng-spsc/src/spsc.rs" 157 4 157 35 *)

(* spsc::RingBuffer<T, N> *)

let%span sinvariant = "../../creusot/creusot-std/src/invariant.rs" 85 8 85 18
let%span sspsc = "crates/ptrng-spsc/src/spsc.rs" 158 11 158 26
let%span sspsc'0 = "crates/ptrng-spsc/src/spsc.rs" 158 48 158 67
let%span sspsc'1 = "crates/ptrng-spsc/src/spsc.rs" 157 17 157 21
let%span sspsc'2 = "crates/ptrng-spsc/src/spsc.rs" 157 26 157 35
let%span sspsc'3 = "crates/ptrng-spsc/src/spsc.rs" 153 14 156 5
let%span sspsc'4 = "crates/ptrng-spsc/src/spsc.rs" 137 21 137 25
let%span sspsc'5 = "crates/ptrng-spsc/src/spsc.rs" 136 14 136 42
let%span sspsc'6 = "crates/ptrng-spsc/src/spsc.rs" 73 12 73 86
let%span sspsc'7 = "crates/ptrng-spsc/src/spsc.rs" 35 12 39 13
let%span sspsc'8 = "crates/ptrng-spsc/src/spsc.rs" 59 20 59 64
let%span sord = "../../creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sarray = "../../creusot/creusot-std/src/std/array.rs" 9 20 9 51
let%span sseq = "../../creusot/creusot-std/src/logic/seq.rs" 994 20 994 91

use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_T

type t_RingBuffer_T = { buf: Slice64.array t_T; fill: t_T; head: UInt64.t; len: UInt64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_N [#"crates/ptrng-spsc/src/spsc.rs" 94 14 94 28] : UInt64.t

predicate invariant_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 58 4 58 30] (self: t_RingBuffer_T) =
  [%#sspsc'8] gt_log_Int (UInt64.t'int const_N) 0
  /\ UInt64.t'int self.head < UInt64.t'int const_N /\ UInt64.t'int self.len <= UInt64.t'int const_N

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = [%#sinvariant] inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate invariant_array_T_n (self: Slice64.array t_T) =
  [%#sarray] inv_Seq_T (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int const_N

predicate inv_array_T_n [@inline:trivial] (_1: Slice64.array t_T) = invariant_array_T_n _1

meta "rewrite_def" predicate inv_array_T_n

predicate inv_RingBuffer_T (_1: t_RingBuffer_T)

axiom inv_axiom [@rewrite]: forall x: t_RingBuffer_T [inv_RingBuffer_T x]. inv_RingBuffer_T x
    = (invariant_RingBuffer_T x /\ inv_array_T_n x.buf /\ inv_T x.fill)

predicate invariant_ref_RingBuffer_T [@inline:trivial] (self: t_RingBuffer_T) = [%#sinvariant] inv_RingBuffer_T self

meta "rewrite_def" predicate invariant_ref_RingBuffer_T

predicate inv_ref_RingBuffer_T [@inline:trivial] (_1: t_RingBuffer_T) = invariant_ref_RingBuffer_T _1

meta "rewrite_def" predicate inv_ref_RingBuffer_T

function slot_index_T [#"crates/ptrng-spsc/src/spsc.rs" 33 4 33 58] (head'0: int) (offset: int) (cap: int) : int =
  [%#sspsc'7] if offset < cap - head'0 then head'0 + offset else offset - (cap - head'0)

function view_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 71 4 71 33] (self: t_RingBuffer_T) : Seq.seq t_T =
  [%#sspsc'6] Seq.create (UInt64.t'int self.len) (fun (i: int) -> Seq.get (Slice64.view self.buf) (slot_index_T (UInt64.t'int self.head) i (UInt64.t'int const_N)))

let is_empty_T (self: t_RingBuffer_T) (return (x: bool)) =
{[@stop_split] [@expl:is_empty 'self' type invariant] [%#sspsc'4] inv_ref_RingBuffer_T self}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:is_empty ensures] [%#sspsc'5] result
    = (Seq.length (view_RingBuffer_T self) = 0)}
    (! return {result}) ]

type t_Option_T = None | Some t_T

predicate inv_Option_T (_1: t_Option_T)

axiom inv_axiom'0 [@rewrite]: forall x: t_Option_T [inv_Option_T x]. inv_Option_T x
    = match x with
      | None -> true
      | Some f0 -> inv_T f0
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let peek_T [#"crates/ptrng-spsc/src/spsc.rs" 157 4 157 35] (self: t_RingBuffer_T) (return (x: t_Option_T)) =
{[@stop_split] [@expl:peek 'self' type invariant] [%#sspsc'1] inv_ref_RingBuffer_T self}
  (! bb0
  [ bb0 = s0
    [ s0 = is_empty_T [%#sspsc] {self} (fun (_x: bool) -> [ &_4 <- _x ] s1)
    | s1 = any [ br0 -> {_4 = false} (! bb3) | br1 -> {_4} (! bb2) ] ]
  | bb2 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ]
  | bb3 = s0
    [ s0 = [ &_7 <- self.head ] s1
    | s1 = [ &_8 <- UInt64.lt _7 ([%#sspsc'0] const_N) ] s2
    | s2 = {[@expl:index in bounds] [%#sspsc'0] _8} s3
    | s3 = Slice64.get [%#sspsc'0] <t_T> {self.buf} {_7} (fun (r: t_T) -> [ &_6 <- r ] s4)
    | s4 = [ &_ret <- Some _6 ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Option_T = Any.any_l ()
  | & self: t_RingBuffer_T = self
  | & _4: bool = Any.any_l ()
  | & _6: t_T = Any.any_l ()
  | & _7: UInt64.t = Any.any_l ()
  | & _8: bool = Any.any_l () ])
  [ return (result: t_Option_T) ->
  {[@stop_split] [@expl:peek_T ensures] ([@stop_split] [@expl:peek result type invariant] [%#sspsc'2] inv_Option_T result)
    /\ ([@stop_split] [@expl:peek ensures] [%#sspsc'3] match result with
      | None -> Seq.length (view_RingBuffer_T self) = 0
      | Some v -> gt_log_Int (Seq.length (view_RingBuffer_T self)) 0 /\ v = Seq.get (view_RingBuffer_T self) 0
      end)}
    (! return {result}) ]
