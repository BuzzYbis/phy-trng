use int.Int

type t_T

type t_RingBuffer_T = { buf: Slice64.array t_T; fill: t_T; head: UInt64.t; len: UInt64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_N [#"crates/ptrng-spsc/src/spsc.rs" 94 14 94 28] : UInt64.t

predicate invariant_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 58 4 58 30] (self: t_RingBuffer_T) =
  [%#sspsc'26] gt_log_Int (UInt64.t'int const_N) 0
  /\ UInt64.t'int self.head < UInt64.t'int const_N /\ UInt64.t'int self.len <= UInt64.t'int const_N

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = [%#sinvariant'0] inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate invariant_array_T_n (self: Slice64.array t_T) =
  [%#sarray] inv_Seq_T (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int const_N

predicate inv_array_T_n [@inline:trivial] (_1: Slice64.array t_T) = invariant_array_T_n _1

meta "rewrite_def" predicate inv_array_T_n

predicate inv_RingBuffer_T (_1: t_RingBuffer_T)

axiom inv_axiom [@rewrite]: forall x: t_RingBuffer_T [inv_RingBuffer_T x]. inv_RingBuffer_T x
    = (invariant_RingBuffer_T x /\ inv_array_T_n x.buf /\ inv_T x.fill)

predicate invariant_ref_RingBuffer_T [@inline:trivial] (self: t_RingBuffer_T) = [%#sinvariant'0] inv_RingBuffer_T self

meta "rewrite_def" predicate invariant_ref_RingBuffer_T

predicate inv_ref_RingBuffer_T [@inline:trivial] (_1: t_RingBuffer_T) = invariant_ref_RingBuffer_T _1

meta "rewrite_def" predicate inv_ref_RingBuffer_T

function slot_index_T [#"crates/ptrng-spsc/src/spsc.rs" 33 4 33 58] (head'0: int) (offset: int) (cap: int) : int =
  [%#sspsc'25] if offset < cap - head'0 then head'0 + offset else offset - (cap - head'0)

function view_RingBuffer_T [#"crates/ptrng-spsc/src/spsc.rs" 71 4 71 33] (self: t_RingBuffer_T) : Seq.seq t_T =
  [%#sspsc'20] Seq.create (UInt64.t'int self.len) (fun (i: int) -> Seq.get (Slice64.view self.buf) (slot_index_T (UInt64.t'int self.head) i (UInt64.t'int const_N)))

let free_T (self: t_RingBuffer_T) (return (x: UInt64.t)) =
{[@stop_split] [@expl:free 'self' type invariant] [%#sspsc'18] inv_ref_RingBuffer_T self}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:free ensures] [%#sspsc'19] UInt64.t'int result
    = UInt64.t'int const_N - Seq.length (view_RingBuffer_T self)}
    (! return {result}) ]

predicate invariant_slice_T (self: Slice64.slice t_T) = [%#sslice'1] inv_Seq_T (Slice64.view self)

predicate inv_slice_T [@inline:trivial] (_1: Slice64.slice t_T) = invariant_slice_T _1

meta "rewrite_def" predicate inv_slice_T

predicate invariant_ref_slice_T [@inline:trivial] (self: Slice64.slice t_T) = [%#sinvariant'0] inv_slice_T self

meta "rewrite_def" predicate invariant_ref_slice_T

predicate inv_ref_slice_T [@inline:trivial] (_1: Slice64.slice t_T) = invariant_ref_slice_T _1

meta "rewrite_def" predicate inv_ref_slice_T

let len_T (self_: Slice64.slice t_T) (return (x: UInt64.t)) =
{[@stop_split] [@expl:len 'self_' type invariant] [%#sslice] inv_ref_slice_T self_}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice'0] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate invariant_refmut_RingBuffer_T [@inline:trivial] (self: MutBorrow.t t_RingBuffer_T) =
  [%#sinvariant] inv_RingBuffer_T self.current /\ inv_RingBuffer_T self.final

meta "rewrite_def" predicate invariant_refmut_RingBuffer_T

predicate inv_refmut_RingBuffer_T [@inline:trivial] (_1: MutBorrow.t t_RingBuffer_T) = invariant_refmut_RingBuffer_T _1

meta "rewrite_def" predicate inv_refmut_RingBuffer_T

let push_into_available_T (self: MutBorrow.t t_RingBuffer_T) (value: t_T) (return (x: ())) =
{[@stop_split] [@expl:push_into_available_T requires] ([@stop_split] [@expl:push_into_available 'self' type invariant] [%#sspsc'21] inv_refmut_RingBuffer_T self)
  /\ ([@stop_split] [@expl:push_into_available 'value' type invariant] [%#sspsc'22] inv_T value)
  /\ ([@stop_split] [@expl:push_into_available requires] [%#sspsc'23] Seq.length (view_RingBuffer_T self.current)
  < UInt64.t'int const_N)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:push_into_available ensures] [%#sspsc'24] view_RingBuffer_T self.final
    = Seq.snoc (view_RingBuffer_T self.current) value}
    (! return {result}) ]

predicate resolve_refmut_RingBuffer_T [@inline:trivial] (_1: MutBorrow.t t_RingBuffer_T) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_RingBuffer_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let push_slice_T [#"crates/ptrng-spsc/src/spsc.rs" 205 4 205 52] (self: MutBorrow.t t_RingBuffer_T)
  (src: Slice64.slice t_T) (return (x: UInt64.t)) =
{[@stop_split] [@expl:push_slice_T requires] ([@stop_split] [@expl:push_slice 'self' type invariant] [%#sspsc'12] inv_refmut_RingBuffer_T self)
  /\ ([@stop_split] [@expl:push_slice 'src' type invariant] [%#sspsc'13] inv_ref_slice_T src)}
  (! bb0
  [ bb0 = s0
    [ s0 = free_T [%#sspsc] {self.current} (fun (_x: UInt64.t) -> [ &avail <- _x ] s1)
    | s1 = len_T [%#sspsc'0] {src} (fun (_x: UInt64.t) -> [ &_17 <- _x ] s2)
    | s2 = [ &_16 <- UInt64.le _17 avail ] s3
    | s3 = any [ br0 -> {_16 = false} (! bb5) | br1 -> {_16} (! bb3) ] ]
  | bb3 = s0 [ s0 = len_T [%#sspsc'1] {src} (fun (_x: UInt64.t) -> [ &count <- _x ] s1) | s1 = bb6 ]
  | bb5 = s0 [ s0 = [ &count <- avail ] s1 | s1 = bb6 ]
  | bb6 = s0
    [ s0 = [ &_old_self <- [%#sspsc'2] self.current ] s1
    | s1 = [ &i <- [%#sspsc'3] (0: UInt64.t) ] s2
    | s2 = [ &_old <- self.final ] s3
    | s3 = bb8 ]
  | bb8 = bb8invariant
    [ bb8 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb8 ([%#sspsc'4] UInt64.t'int count
      - UInt64.t'int i)}
      bb8invariant
    | bb8invariant = {[@expl:inferred invariant: type invariant] inv_refmut_RingBuffer_T self}
      {[@expl:inferred invariant: unchanged value] _old = self.final}
      {[@expl:loop invariant #0] [%#sspsc'6] UInt64.t'int i <= UInt64.t'int count}
      {[@expl:loop invariant #1] [%#sspsc'5] view_RingBuffer_T self.current
      = Seq.(++) (view_RingBuffer_T _old_self) (Seq.([..]) (Slice64.view src) 0 (UInt64.t'int i))}
      (! [ &variant_old_bb8 <- [%#sspsc'4] UInt64.t'int count - UInt64.t'int i ] s0)
      [ s0 = [ &_39 <- UInt64.lt i count ] s1 | s1 = any [ br0 -> {_39 = false} (! bb13) | br1 -> {_39} (! bb10) ] ]
      [ bb10 = s0
        [ s0 = [ &_45 <- i ] s1
        | s1 = [ &_46 <- Slice64.length src ] s2
        | s2 = [ &_47 <- UInt64.lt _45 _46 ] s3
        | s3 = {[@expl:index in bounds] [%#sspsc'7] _47} s4
        | s4 = Slice64.get [%#sspsc'7] <t_T> {src} {_45} (fun (r: t_T) -> [ &_44 <- r ] s5)
        | s5 = MutBorrow.borrow_mut <t_RingBuffer_T> {self.current}
            (fun (_bor: MutBorrow.t t_RingBuffer_T) ->
              [ &_43 <- _bor ] -{inv_RingBuffer_T _bor.final}-
              [ &self <- { self with current = _bor.final } ] s6)
          [ _ck -> (! {[@expl:type invariant] inv_RingBuffer_T self.current} any) ]
        | s6 = push_into_available_T [%#sspsc'8] {_43} {_44} (fun (_x: ()) -> [ &_42 <- _x ] s7)
        | s7 =
          {[@expl:assertion] [%#sspsc'9] Seq.(==) (view_RingBuffer_T self.current) (Seq.(++) (view_RingBuffer_T _old_self) (Seq.([..]) (Slice64.view src) 0 (UInt64.t'int i
          + 1)))}
          s8
        | s8 = UInt64.add [%#sspsc'11] {i} {[%#sspsc'10] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s9)
        | s9 = bb8 ] ] ]
  | bb13 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_RingBuffer_T self} any) ]
    | s1 = -{resolve_refmut_RingBuffer_T self}- s2
    | s2 = [ &_ret <- count ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & self: MutBorrow.t t_RingBuffer_T = self
  | & src: Slice64.slice t_T = src
  | & avail: UInt64.t = Any.any_l ()
  | & count: UInt64.t = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _17: UInt64.t = Any.any_l ()
  | & _old_self: t_RingBuffer_T = Any.any_l ()
  | & i: UInt64.t = Any.any_l ()
  | & _39: bool = Any.any_l ()
  | & _42: () = Any.any_l ()
  | & _43: MutBorrow.t t_RingBuffer_T = Any.any_l ()
  | & _44: t_T = Any.any_l ()
  | & _45: UInt64.t = Any.any_l ()
  | & _46: UInt64.t = Any.any_l ()
  | & _47: bool = Any.any_l ()
  | & _old: t_RingBuffer_T = Any.any_l ()
  | & variant_old_bb8: int = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:push_slice_T ensures] ([@stop_split] [@expl:push_slice ensures #0] [%#sspsc'14] UInt64.t'int result
      <= Seq.length (Slice64.view src))
    /\ ([@stop_split] [@expl:push_slice ensures #1] [%#sspsc'15] UInt64.t'int result
      <= UInt64.t'int const_N - Seq.length (view_RingBuffer_T self.current))
    /\ ([@stop_split] [@expl:push_slice ensures #2] [%#sspsc'16] UInt64.t'int result
      = (if Seq.length (Slice64.view src) <= UInt64.t'int const_N - Seq.length (view_RingBuffer_T self.current) then
        Seq.length (Slice64.view src)
      else
        UInt64.t'int const_N - Seq.length (view_RingBuffer_T self.current)
      ))
    /\ ([@stop_split] [@expl:push_slice ensures #3] [%#sspsc'17] view_RingBuffer_T self.final
    = Seq.(++) (view_RingBuffer_T self.current) (Seq.([..]) (Slice64.view src) 0 (UInt64.t'int result)))}
    (! return {result}) ]
