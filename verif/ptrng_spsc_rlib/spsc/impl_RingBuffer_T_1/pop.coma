(* spsc::RingBuffer<T, N> *)

let%span sinvariant = "../../creusot/creusot-std/src/invariant.rs" 93 20 93 44
let%span sinvariant'0 = "../../creusot/creusot-std/src/invariant.rs" 85 8 85 18
let%span sspsc = "crates/ptrng-spsc/src/spsc.rs" 192 11 192 26
