(* #"crates/ptrng-spsc/src/error.rs" 30 4 30 60 *)

(* <error::SpscError as core::fmt::Display> *)

let%span serror = "crates/ptrng-spsc/src/error.rs" 32 40 32 61
let%span serror'0 = "crates/ptrng-spsc/src/error.rs" 32 28 32 62
let%span serror'1 = "crates/ptrng-spsc/src/error.rs" 30 18 30 19
let%span sfmt = "../../creusot/creusot-std/src/std/fmt.rs" 7 26 7 30
let%span sinvariant = "../../creusot/creusot-std/src/invariant.rs" 93 20 93 44

use creusot.prelude.MutBorrow
use creusot.prelude.Any

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

type t_Result_unit_Error = Ok () | Err ()

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  [%#sinvariant] inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

let write_str (self_: MutBorrow.t t_Formatter) (data: string) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_str 'self_' type invariant] [%#sfmt] inv_refmut_Formatter self_}
  any [ return (result: t_Result_unit_Error) -> (! return {result}) ]

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

type t_SpscError = Full

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let fmt_SpscError [#"crates/ptrng-spsc/src/error.rs" 30 4 30 60] (self: t_SpscError) (f: MutBorrow.t t_Formatter)
  (return (x: t_Result_unit_Error)) = {[@stop_split] [@expl:fmt 'f' type invariant] [%#serror'1] inv_refmut_Formatter f}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_5 <- [%#serror] "ring buffer is full" ] s1
    | s1 = MutBorrow.borrow_final <t_Formatter> {f.current} {MutBorrow.get_id f}
        (fun (_bor: MutBorrow.t t_Formatter) ->
          [ &_3 <- _bor ] -{inv_Formatter _bor.final}-
          [ &f <- { f with current = _bor.final } ] s2)
      [ _ck -> (! {[@expl:type invariant] inv_Formatter f.current} any) ]
    | s2 = write_str [%#serror'0] {_3} {_5} (fun (_x: t_Result_unit_Error) -> [ &_ret <- _x ] s3)
    | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_refmut_Formatter f} any) ]
    | s4 = -{resolve_refmut_Formatter f}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Result_unit_Error = Any.any_l ()
  | & f: MutBorrow.t t_Formatter = f
  | & _3: MutBorrow.t t_Formatter = Any.any_l ()
  | & _5: string = Any.any_l () ]) [ return (result: t_Result_unit_Error) -> (! return {result}) ]
